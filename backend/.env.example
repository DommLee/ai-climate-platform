APP_NAME=AI Climate Platform API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

CORS_ORIGINS=http://localhost:5180,http://localhost:4173
TRUSTED_HOSTS=localhost,127.0.0.1,api

DATABASE_URL=postgresql+psycopg://climate:climate@postgres:5432/climate
REDIS_URL=redis://redis:6379/0

INGEST_INTERVAL_MINUTES=15
INGEST_CORE_LOCATIONS_ONLY=true
REPORT_WORKER_POLL_SECONDS=5
DATA_FRESHNESS_MINUTES=90
REQUEST_TIMEOUT_SECONDS=20

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_PRIMARY_PROVIDER=openai
LLM_SECONDARY_PROVIDER=gemini
LLM_TIMEOUT_SECONDS=25
LLM_MAX_INPUT_CHARS=14000
LLM_MAX_OUTPUT_TOKENS=900
LLM_PROMPT_VERSION=v1
LLM_TOKEN_COST_INPUT_PER_1K=0.003
LLM_TOKEN_COST_OUTPUT_PER_1K=0.015
LLM_MAX_COST_USD_PER_CALL=0.35

ALLOWLIST_DOMAINS=open-meteo.com,power.larc.nasa.gov,cds.climate.copernicus.eu,docs.openaq.org,openaq.org,apidoc.reliefweb.int,reliefweb.int,gdeltproject.org,news.google.com,undrr.org,emdat.be,worldbank.org,api.worldbank.org,ourworldindata.org
SECRET_MANAGER_MODE=env
# Optional env binding examples:
# OPENAI_API_KEY_SECRET_NAME=PROD_OPENAI_KEY
# GEMINI_API_KEY_SECRET_NAME=PROD_GEMINI_KEY

REPORT_OUTPUT_DIR=./reports
ENABLE_SCHEDULER_IN_API=false

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
MAX_EVENT_RECORDS_PER_SOURCE=25
EMDAT_API_URL=
EMDAT_API_KEY=
COPERNICUS_API_URL=
COPERNICUS_API_KEY=
